{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Vaultrs",
    "version": "0.1.0",
    "identifier": "com.huy1235588.vaultrs",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "Vaultrs",
                "width": 1280,
                "height": 800,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "center": true,
                "maximized": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline'",
            "assetProtocol": {
                "enable": true,
                "scope": ["**"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/logo.png",
            "icons/logo.ico"
        ]
    }
}